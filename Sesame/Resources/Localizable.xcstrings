    "Tous les documents chiffrés seront supprimés de cet appareil. Cette action est irréversible." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف جميع المستندات المشفرة من هذا الجهاز. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
