    "Le code à 6 chiffres déverrouille votre coffre si Face ID n'est pas disponible." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح الرمز المكوّن من 6 أرقام خزنتك عندما يكون Face ID غير متاح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der 6-stellige Code entsperrt Ihren Tresor, wenn Face ID nicht verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The 6-digit code unlocks your vault when Face ID is unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código de 6 dígitos desbloquea tu caja fuerte si Face ID no está disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice a 6 cifre sblocca la cassaforte se Face ID non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDが使えないときは、6桁のコードで金庫をロック解除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID를 사용할 수 없을 때 6자리 코드로 금고를 잠금 해제합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 6-cijferige code ontgrendelt je kluis als Face ID niet beschikbaar is."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O código de 6 dígitos desbloqueia o cofre se o Face ID não estiver disponível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当面容ID不可用时，6位PIN码可解锁您的保险库。"
          }
        }
      }
    },
    "Le coffre gratuit est limité à 3 documents. Débloquez un coffre illimité, pour toujours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخزنة المجانية محدودة بثلاثة مستندات. افتح خزنة غير محدودة، إلى الأبد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der kostenlose Tresor ist auf 3 Dokumente begrenzt. Schalten Sie einen unbegrenzten Tresor frei – für immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The free vault is limited to 3 documents. Unlock an unlimited vault, forever."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caja fuerte gratuita está limitada a 3 documentos. Desbloquea una caja ilimitada, para siempre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cassaforte gratuita è limitata a 3 documenti. Sblocca una cassaforte illimitata, per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料版の金庫は書類3件までです。無制限の金庫をずっと使えるようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 금고는 문서 3개로 제한됩니다. 무제한 금고를 영구적으로 잠금 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gratis kluis is beperkt tot 3 documenten. Ontgrendel een onbeperkte kluis, voor altijd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cofre gratuito está limitado a 3 documentos. Desbloqueie um cofre ilimitado, para sempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费版保险库最多存放3个文档。一次解锁，永久无限。"
          }
        }
      }
    },
    "Le document est maintenant chiffré dans Sésame. L'original en clair peut être retiré de votre galerie." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المستند الآن مشفر في Sésame. يمكن إزالة الأصل غير المشفر من معرضك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dokument ist jetzt in Sésame verschlüsselt. Das unverschlüsselte Original kann aus Ihrer Galerie entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The document is now encrypted in Sésame. The unencrypted original can be removed from your gallery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El documento ya está cifrado en Sésame. El original sin cifrar puede eliminarse de tu galería."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il documento è ora cifrato in Sésame. L'originale non cifrato può essere rimosso dalla galleria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書類はSésame内で暗号化されました。暗号化されていない元の写真はギャラリーから削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문서가 Sésame에 암호화되어 저장되었습니다. 암호화되지 않은 원본은 갤러리에서 제거할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het document is nu versleuteld in Sésame. Het onversleutelde origineel kan uit je galerij worden verwijderd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O documento está agora cifrado no Sésame. O original não cifrado pode ser removido da sua galeria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文档已在Sésame中加密。未加密的原件可以从图库中移除。"
          }
        }
      }
    },
    "Le fichier chiffré sera définitivement effacé de l'appareil." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُمحى الملف المشفر نهائيًا من الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die verschlüsselte Datei wird endgültig vom Gerät gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The encrypted file will be permanently erased from this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo cifrado se borrará definitivamente del dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file cifrato verrà eliminato definitivamente dal dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されたファイルは端末から完全に消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화된 파일이 기기에서 영구적으로 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het versleutelde bestand wordt definitief van het apparaat gewist."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ficheiro cifrado será apagado definitivamente do dispositivo."
          }
        },
