    "Choisissez le fichier exporté depuis Sésame, puis saisissez la phrase de récupération notée lors de l'export." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الملف المُصدَّر من Sésame، ثم أدخل عبارة الاسترداد التي دوّنتها عند التصدير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie die aus Sésame exportierte Datei und geben Sie die beim Export notierte Wiederherstellungsphrase ein."
          }
        },
