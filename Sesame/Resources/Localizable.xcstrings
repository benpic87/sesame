    "L'étiquette sera retirée des documents qui la portent. Les documents ne sont pas supprimés." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُزال الوسم من المستندات التي تحمله. لن تُحذف المستندات نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Etikett wird von allen Dokumenten entfernt, die es tragen. Die Dokumente selbst werden nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tag will be removed from documents that carry it. The documents themselves are not deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La etiqueta se quitará de los documentos que la lleven. Los documentos no se eliminan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'etichetta verrà rimossa dai documenti che la portano. I documenti non vengono eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグは付いている書類から外されます。書類自体は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 태그가 붙은 문서에서 태그만 제거됩니다. 문서는 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het label wordt verwijderd van documenten die het dragen. De documenten zelf worden niet verwijderd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A etiqueta será removida dos documentos que a têm. Os documentos não são apagados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标签将从带有它的文档中移除。文档本身不会被删除。"
          }
        }
      }
    },
    "L'original peut être supprimé après import" : {
      "localizations" : {
