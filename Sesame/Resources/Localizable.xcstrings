    "Sésame garde vos passeports, cartes et papiers importants chiffrés sur votre téléphone. Pas de compte, pas de nuage, pas de trace." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Sésame جوازات سفرك وبطاقاتك وأوراقك المهمة مشفرة على هاتفك. لا حساب، لا سحابة، لا أثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sésame bewahrt Ihre Reisepässe, Karten und wichtigen Papiere verschlüsselt auf Ihrem Telefon auf. Kein Konto, keine Cloud, keine Spur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sésame keeps your passports, cards and important papers encrypted on your phone. No account, no cloud, no trace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sésame guarda tus pasaportes, tarjetas y papeles importantes cifrados en tu teléfono. Sin cuenta, sin nube, sin rastro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sésame conserva passaporti, carte e documenti importanti cifrati sul tuo telefono. Nessun account, nessun cloud, nessuna traccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sésameはパスポートやカード、大切な書類を暗号化して、この電話の中だけに保管します。アカウントもクラウドも痕跡もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sésame는 여권, 카드, 중요한 서류를 암호화하여 휴대폰 안에만 보관합니다. 계정도, 클라우드도, 흔적도 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sésame bewaart je paspoorten, kaarten en belangrijke papieren versleuteld op je telefoon. Geen account, geen cloud, geen spoor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sésame guarda os seus passaportes, cartões e papéis importantes cifrados no seu telemóvel. Sem conta, sem nuvem, sem rasto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sésame将您的护照、证件和重要文件加密保存在手机上。没有账户，没有云端，没有痕迹。"
          }
        }
      }
    },
    "Sésame Premium" : {
      "shouldTranslate" : false
    },
    "Simple. Privé. Tout reste ici, sur votre téléphone." : {
